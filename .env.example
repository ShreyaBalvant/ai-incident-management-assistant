# ==============================================================================
# AI Incident Management Assistant - Environment Configuration
# ==============================================================================

# Primary LLM Provider: Groq LLaMA (Open Source, Fast, Free Tier)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary / Fallback LLM Provider: Google Gemini
# Get an API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Provider Priority Order (comma-separated: groq,gemini or gemini,groq)
# Default is 'groq,gemini' which prioritizes Groq LLaMA on Priority 1!
LLM_PROVIDER_ORDER=groq,gemini

# Optional: Custom SQLite database path (useful for Docker volume mounts)
# DB_PATH=/app/data_volume/incidents.db

# Optional: Server Port for Cloud Deployments (Render, Cloud Run, etc.)
# PORT=8501
